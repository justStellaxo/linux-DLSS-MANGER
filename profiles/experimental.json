{
  "enable_nvapi": true,
  "enable_smooth_motion": true,
  "use_gamemode": true,
  "use_mangohud": true,
  "dlss_mode": "force_version",
  "dlss_version": "3.7.10",
  "allow_unsupported_override": true,
  "safety_mode": "unsafe",
  "launch_args": "--prototype-experimental",
  "custom_env": {
    "DXVK_HUD": "full"
  },
  "dlss_sr_preset": "latest",
  "dlss_rr_preset": "latest",
  "dlss_fg_override": "on",
  "enable_ngx_updater": true,
  "enable_hags": true,
  "enable_vkreflex": true,
  "proton_dlss_upgrade": "1"
}